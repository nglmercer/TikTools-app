          "header": "Idempotency-Key"
        },
        "timeoutMs": 10000
      },
      "optionSources": {
        "instanceId": {
          "path": "/api/entities",
          "itemsPath": "entities",
          "valuePath": "id",
          "labelPath": "catalogId"
        }
      }
    },
    {
      "id": "peak.game.clear-entities",
      "version": 1,
      "title": {
        "default": "Clear API owned objects"
      },
      "description": {
        "default": "Remove the objects PEAKapi created. Objects of the game or of other mods are never touched."
      },
      "tag": "peak",
      "icon": "terminal",
      "category": "PEAK",
      "requiredCapabilities": [
        "http.request"
      ],
      "fields": [
        {
          "key": "kind",
          "label": {
            "default": "Kind"
          },
          "kind": "select",
          "value": "all",
          "options": [
            {
              "value": "all",
              "label": {
                "default": "All"
              }
            },
            {
              "value": "entity",
              "label": {
                "default": "Entities only"
              }
            },
            {
              "value": "hazard",
              "label": {
                "default": "Hazards only"
              }
            }
          ]
        }
      ],
      "http": {
        "method": "POST",
        "path": "/api/entities/clear",
        "headers": {
          "Content-Type": "application/json"
        },
        "bodyJson": {
          "kind": {
            "$value": "config.kind"
          }
        },
        "idempotency": {
          "enabled": true,
          "header": "Idempotency-Key"
        },
        "timeoutMs": 10000
      },
      "optionSources": {}
