                }
              }
            }
          }
        }
      },
      "optionSources": {
        "entityId": {
          "path": "/api/catalog/entities",
          "itemsPath": "entities",
          "valuePath": "id",
          "labelPath": "name"
        },
        "playerId": {
          "path": "/api/players",
          "itemsPath": "players",
          "valuePath": "id",
          "labelPath": "name"
        }
      }
    },
