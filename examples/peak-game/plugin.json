    {
      "id": "peak.game.despawn-entity",
      "version": 1,
      "title": {
        "default": "Despawn API owned object"
      },
      "description": {
        "default": "Despawn an object that PEAKapi created. Objects of the game are never touched."
      },
      "tag": "peak",
      "icon": "terminal",
      "category": "PEAK",
      "requiredCapabilities": [
        "http.request"
      ],
      "fields": [
        {
          "key": "instanceId",
          "label": {
            "default": "Spawned instance"
          },
          "kind": "select",
          "value": "",
          "optionsFrom": "plugin-action-options:peak.game.despawn-entity:instanceId"
        }
      ],
      "http": {
        "method": "POST",
        "path": "/api/entities/despawn",
        "headers": {
          "Content-Type": "application/json"
        },
        "bodyJson": {
          "instanceId": {
            "$value": "config.instanceId"
          }
        },
        "idempotency": {
