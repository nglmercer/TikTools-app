{
  "schemaVersion": 3,
  "id": "sonicboom.server",
  "name": "SonicBoom Server",
  "version": "1.0.0",
  "description": "Speak chat and events through a local or remote SonicBoom TTS server over plain HTTP. No plugin code runs: the host interprets every action, voice list, template, and page.",
  "runtime": "declarative",
  "capabilities": ["http.request"],
  "permissions": ["network.bind"],
  "http": {
    "baseUrl": "{{ settings.serverUrl }}",
    "timeoutMs": 10000,
    "auth": {
      "type": "bearer",
      "tokenSetting": "apiToken"
    },
    "health": {
      "path": "/ready",
      "timeoutMs": 5000
    }
  },
  "actionTypes": [
    {
      "id": "sonicboom.server.speak",
      "version": 1,
      "title": {"default": "Speak with SonicBoom", "i18key": "sonicboom.server.speak.title"},
      "description": {"default": "Send text to the SonicBoom server for speech synthesis.", "i18key": "sonicboom.server.speak.description"},
      "tag": "tts",
      "requiredCapabilities": ["http.request"],
      "fields": [
        {
          "key": "text",
          "label": {"default": "Text", "i18key": "sonicboom.server.speak.text.label"},
          "kind": "textarea",
          "value": "{{ event.data.comment }}",
          "template": true,
          "placeholder": "{{ event.data.comment }}",
          "hint": {"default": "Spoken text. Event placeholders render before sending.", "i18key": "sonicboom.server.speak.text.hint"}
        },
        {
          "key": "voice",
          "label": {"default": "Voice", "i18key": "sonicboom.server.speak.voice.label"},
          "kind": "select",
          "value": "",
          "optionsFrom": "plugin-action-options:sonicboom.server.speak:voice",
          "hint": {"default": "Voices load live from the server. Empty keeps the server default.", "i18key": "sonicboom.server.speak.voice.hint"}
        },
        {
          "key": "language",
          "label": {"default": "Language", "i18key": "sonicboom.server.speak.language.label"},
          "kind": "text",
          "value": "en",
          "placeholder": "en"
        },
        {
          "key": "playNow",
          "label": {"default": "Interrupt and play now", "i18key": "sonicboom.server.speak.playNow.label"},
          "kind": "boolean",
          "value": "false",
          "advanced": true
        }
      ],
      "http": {
        "method": "POST",
        "path": "/api/tts/play?voice={{ config.voice }}&lang={{ config.language }}&play_now={{ config.playNow }}",
        "headers": {
          "Content-Type": "text/plain"
        },
        "body": "{{ config.text }}",
        "timeoutMs": 15000
      },
      "optionSources": {
        "voice": {
          "path": "/v1/voices",
          "timeoutMs": 8000
        }
      }
    }
  ],
  "settings": {
    "schema": {
      "type": "object",
      "properties": {
        "serverUrl": {
          "type": "string",
          "title": "Server URL",
          "description": "Base URL of the SonicBoom server.",
          "default": "http://localhost:3000"
        },
        "apiToken": {
          "type": "string",
          "title": "API token",
          "description": "Bearer token. Optional on this machine, required for remote servers.",
          "secret": true
        },
        "defaultVoice": {
          "type": "string",
          "title": "Default voice",
          "description": "Preferred voice for new actions and templates."
        },
        "defaultLanguage": {
          "type": "string",
          "title": "Default language",
          "description": "Language code sent with speech requests.",
          "default": "en"
        }
      }
    },
    "uiHints": {
      "fields": {
        "serverUrl": {
          "placeholder": "http://localhost:3000"
        },
        "apiToken": {
          "secret": true
        },
        "defaultVoice": {
          "optionsFrom": "plugin-action-options:sonicboom.server.speak:voice"
        }
      }
    }
  },
  "templates": [
    {
      "id": "chat-tts",
      "title": {"default": "Chat to TTS (SonicBoom)", "i18key": "sonicboom.server.template.chat-tts.title"},
      "description": {"default": "Speak incoming chat through the SonicBoom server.", "i18key": "sonicboom.server.template.chat-tts.description"},
      "icon": "voice",
      "eventType": "tiktok.chat",
      "requiredNodeTypes": ["trigger.event", "action.http"],
      "category": "Voice",
      "params": {
        "type": "object",
        "properties": {
          "serverUrl": {
            "type": "string",
            "title": "Server URL",
            "default": "http://localhost:3000"
          },
          "voice": {
            "type": "string",
            "title": "Voice",
            "default": "M1"
          },
          "language": {
            "type": "string",
            "title": "Language",
            "default": "en"
          },
          "playNow": {
            "type": "boolean",
            "title": "Interrupt and play now",
            "default": false
          }
        }
      },
      "workflow": {
        "nodes": [
          {
            "type": "trigger.event",
            "config": {
              "eventType": "tiktok.chat"
            }
          },
          {
            "type": "action.http",
            "config": {
              "method": "POST",
              "url": "{{ params.serverUrl }}/api/tts/play?voice={{ params.voice }}&lang={{ params.language }}&play_now={{ params.playNow }}",
              "headers": {
                "Content-Type": "text/plain"
              },
              "body": "{{ event.data.comment }}",
              "bodyMode": "text",
              "timeoutMs": 10000,
              "responseType": "json",
              "allowPrivateNetwork": true
            }
          }
        ]
      }
    }
  ],
  "pages": [
    {
      "id": "connection",
      "title": {"default": "Connection", "i18key": "sonicboom.server.page.connection.title"},
      "icon": "radio",
      "sections": [
        {
          "kind": "text",
          "text": {"default": "Point TikTools at a SonicBoom server, then test the connection before building automations.", "i18key": "sonicboom.server.page.connection.intro"}
        },
        {
          "kind": "connection"
        },
        {
          "kind": "form",
          "title": {"default": "Server settings", "i18key": "sonicboom.server.page.connection.form"}
        }
      ]
    },
    {
      "id": "voices",
      "title": {"default": "Voices", "i18key": "sonicboom.server.page.voices.title"},
      "icon": "voice",
      "sections": [
        {
          "kind": "text",
          "text": {"default": "Voices currently offered by the configured server.", "i18key": "sonicboom.server.page.voices.intro"}
        },
        {
          "kind": "list",
          "title": {"default": "Available voices", "i18key": "sonicboom.server.page.voices.list"},
          "optionsFrom": "plugin-action-options:sonicboom.server.speak:voice"
        }
      ]
    }
  ]
}
