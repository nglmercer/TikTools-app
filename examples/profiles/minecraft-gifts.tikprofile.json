{
  "profileVersion": 1,
  "id": "minecraft-gifts",
  "name": "Minecraft gifts",
  "description": "TikTok LIVE gifts drive Minecraft commands through the local CommandAPI (http://127.0.0.1:8080/api/chat). Roses give apples, Galaxies give diamonds, TNT gives TNT, GG grants speed, Hearts heal, and follows post a welcome message. Every rule fires one batched `messages` request: the reward command plus an on-screen title and subtitle announcing the sender. Override commandHost/commandPort once for the whole profile.",
  "params": {
    "commandHost": "127.0.0.1",
    "commandPort": 8080
  },
  "templates": [
    {
      "template": {
        "templateVersion": 1,
        "id": "minecraft-rose-apple",
        "title": "Rose gives apples",
        "description": "Every Rose sends one batched request: /give @p minecraft:apple <count> plus an on-screen ROSE! title and thanks subtitle.",
        "icon": "gift",
        "params": {
          "type": "object",
          "properties": {
            "commandHost": { "type": "string", "title": "CommandAPI host", "default": "127.0.0.1" },
            "commandPort": { "type": "number", "title": "CommandAPI port", "default": 8080 }
          }
        },
        "actions": [
          {
            "name": "Give apples for Roses",
            "typeId": "core.fetch",
            "enabled": true,
            "config": {
              "method": "POST",
              "url": "http://{{ params.commandHost }}:{{ params.commandPort }}/api/chat",
              "headers": { "Content-Type": "application/json" },
              "body": "{\"messages\": [\"/give @p minecraft:apple {{ event.data.repeatCount }}\", \"/title @a times 10 50 10\", \"/title @a subtitle {\\\"text\\\":\\\"Thanks {{ event.user.nickname }}!\\\",\\\"color\\\":\\\"white\\\"}\", \"/title @a title {\\\"text\\\":\\\"ROSE!\\\",\\\"color\\\":\\\"red\\\",\\\"bold\\\":true}\"]}",
              "timeoutMs": 5000,
              "emitResponseAs": "",
              "allowPrivateNetwork": true
            }
          }
        ],
        "event": {
          "name": "Minecraft Rose",
          "enabled": true,
          "trigger": "tiktok.gift",
          "filters": [{ "path": "event.data.giftName", "operator": "eq", "value": "Rose" }],
          "cooldownMs": 0,
          "cooldownScope": "global",
          "runMode": "all"
        }
      },
      "params": {}
    },
    {
