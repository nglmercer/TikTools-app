{
  "profileVersion": 1,
  "id": "minecraft-gift-board",
  "name": "Minecraft gift board",
  "description": "Nine TikTok LIVE gifts driving Minecraft commands through the local CommandAPI at http://{{ globals.commandHost }}:{{ globals.commandPort }}/api/chat. TNT gives TNT, Fire gives fire charges, Roses give apples, Crowns grant totems, GG grants speed, Galaxies give diamonds, Hearts heal, Ghosts summon a ghast, and Lions grant a netherite sword. Set commandHost/commandPort once as runtime globals (CLI `tiktools globals set` or the desktop Settings tab) — no re-import when the port changes.",
  "params": {},
  "templates": [
    {
      "template": {
        "templateVersion": 1,
        "id": "minecraft-board-tnt",
        "title": "TNT gives TNT",
        "description": "Every TNT gift sends /give @p minecraft:tnt <count> to the local player.",
        "icon": "gift",
        "actions": [
          {
            "name": "Give TNT for TNT gifts",
            "typeId": "core.fetch",
            "enabled": true,
            "config": {
              "method": "POST",
              "url": "http://{{ globals.commandHost }}:{{ globals.commandPort }}/api/chat",
              "headers": { "Content-Type": "application/json" },
              "body": "{\"text\": \"/give @p minecraft:tnt {{ event.data.repeatCount }}\"}",
              "timeoutMs": 5000,
              "emitResponseAs": "",
              "allowPrivateNetwork": true
            }
          }
        ],
        "event": {
          "name": "Minecraft board TNT",
          "enabled": true,
          "trigger": "tiktok.gift",
          "filters": [{ "path": "event.data.giftName", "operator": "eq", "value": "TNT" }],
          "cooldownMs": 0,
          "cooldownScope": "global",
          "runMode": "all"
        }
      },
      "params": {}
    },
