            {
              "value": "f11"
            },
            {
              "value": "f12"
            },
            {
              "value": "space"
            },
            {
              "value": "enter"
            },
            {
              "value": "tab"
            },
            {
              "value": "esc"
            },
            {
              "value": "backspace"
