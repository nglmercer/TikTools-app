            {
              "value": "right"
            },
            {
              "value": "capslock"
            },
            {
              "value": ","
            },
            {
              "value": "."
            },
            {
              "value": "/"
            },
            {
              "value": ";"
            },
            {
              "value": "'"
            },
            {
              "value": "["
            },
            {
              "value": "]"
            },
            {
              "value": "\\"
            },
            {
              "value": "-"
            },
            {
              "value": "="
            },
            {
              "value": "`"
            }
          ]
        },
        {
          "path": "event.data.modifiers",
          "kind": "text",
          "label": {
            "default": "Modifiers",
            "i18key": "hotkeys.field.modifiers.label"
          },
          "hint": {
            "default": "Held modifiers joined with +: ctrl, shift, alt, meta. Empty when none are held.",
            "i18key": "hotkeys.field.modifiers.hint"
          },
          "options": [
            {
              "value": "",
              "label": {
                "default": "none"
              }
            },
            {
              "value": "ctrl",
              "label": {
                "default": "ctrl"
              }
            },
            {
              "value": "shift",
              "label": {
                "default": "shift"
              }
            },
            {
              "value": "alt",
              "label": {
                "default": "alt"
              }
            },
            {
              "value": "meta",
              "label": {
                "default": "meta"
              }
            },
            {
              "value": "ctrl+shift",
              "label": {
                "default": "ctrl+shift"
              }
            },
            {
              "value": "ctrl+alt",
              "label": {
                "default": "ctrl+alt"
              }
            },
            {
              "value": "ctrl+meta",
              "label": {
                "default": "ctrl+meta"
              }
            },
            {
              "value": "shift+alt",
              "label": {
                "default": "shift+alt"
              }
            },
            {
              "value": "shift+meta",
              "label": {
                "default": "shift+meta"
              }
            },
            {
              "value": "alt+meta",
              "label": {
                "default": "alt+meta"
              }
            },
            {
              "value": "ctrl+shift+alt",
              "label": {
                "default": "ctrl+shift+alt"
              }
            },
            {
              "value": "ctrl+shift+meta",
              "label": {
                "default": "ctrl+shift+meta"
              }
            },
            {
              "value": "ctrl+alt+meta",
              "label": {
                "default": "ctrl+alt+meta"
              }
            },
            {
              "value": "shift+alt+meta",
              "label": {
                "default": "shift+alt+meta"
              }
            },
            {
              "value": "ctrl+shift+alt+meta",
              "label": {
                "default": "ctrl+shift+alt+meta"
              }
            }
          ]
        },
        {
          "path": "event.data.sequence",
          "kind": "text",
          "label": {
            "default": "Sequence",
            "i18key": "hotkeys.field.sequence.label"
          },
          "hint": {
            "default": "Recent keys, oldest first, space separated. Match chords with eq, phrases with contains.",
            "i18key": "hotkeys.field.sequence.hint"
          }
        },
        {
          "path": "event.data.backend",
          "kind": "text",
          "label": {
            "default": "Backend",
            "i18key": "hotkeys.field.backend.label"
          },
          "hint": {
            "default": "Listener that observed the press: rdev, x11, portal, or evdev.",
            "i18key": "hotkeys.field.backend.hint"
          }
        },
        {
          "path": "event.data.shortcut_id",
          "kind": "text",
          "label": {
            "default": "Shortcut ID",
            "i18key": "hotkeys.field.shortcut.label"
          },
          "hint": {
            "default": "Portal shortcut id (for example ctrl-shift-k). Only set on portal events.",
            "i18key": "hotkeys.field.shortcut.hint"
          }
        }
      ],
      "sample": {
        "key": "k",
        "modifiers": "ctrl",
        "sequence": "g k"
      }
    },
    {
      "type": "hotkey.status",
      "title": {
        "default": "Hotkey listener status",
        "i18key": "hotkeys.status.title"
      },
      "description": {
        "default": "Emitted when a keyboard backend starts, fails, or needs permission. Use it to show listener health instead of polling blindly.",
        "i18key": "hotkeys.status.description"
      },
      "fields": [
        {
          "path": "event.data.platform",
          "kind": "text",
          "label": {
            "default": "Platform",
            "i18key": "hotkeys.status.field.platform.label"
          }
        },
        {
          "path": "event.data.session",
          "kind": "text",
          "label": {
            "default": "Session",
            "i18key": "hotkeys.status.field.session.label"
          },
          "hint": {
            "default": "linux session kind: wayland, x11, or unknown. n/a on Windows/macOS.",
            "i18key": "hotkeys.status.field.session.hint"
          }
        }
      ],
      "sample": {
        "platform": "linux",
        "session": "wayland",
        "backends": [
          {
            "backend": "portal",
            "state": "active",
            "detail": "3 shortcuts bound",
            "summary": "Global Hotkeys: active via XDG Desktop Portal (3 shortcuts bound)"
          }
        ]
      }
    }
  ]
}
