{
  "schemaVersion": 3,
  "id": "tiktools.twitch",
  "name": "Twitch Live",
  "version": "0.1.0",
  "publisher": "tiktools",
  "license": "MIT",
  "description": "Reference Twitch live-platform source using anonymous read-only IRC. Maps Twitch public chat, subscriptions and Bits into canonical live events; the host owns validation, feed, automation, points and analytics.",
  "icon": "video",
  "tags": ["live", "twitch", "platform"],
  "runtime": "process",
  "trust": "trusted",
  "entry": "tiktools-twitch-plugin",
  "protocolVersion": 1,
  "permissions": ["network.connect"],
  "capabilities": ["events.publish", "live.ingest"],
  "eventTypes": [
    {
      "type": "platform.live.ingest",
      "title": { "default": "Live platform ingestion" },
      "description": { "default": "Host-validated canonical live ingestion batches." }
    }
  ],
  "settings": {
    "schema": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string",
          "title": { "default": "Twitch channel" },
          "description": { "default": "Login name of the channel to join, without #." }
        }
      }
    },
    "uiHints": {
      "fields": {
        "channel": {
          "placeholder": "shroud",
          "hint": { "default": "Channel login name without # or URL." }
        }
      }
    }
  },
  "actionTypes": [
    {
      "id": "tiktools.twitch.connect",
      "version": 1,
      "title": { "default": "Connect Twitch" },
      "description": { "default": "Connect anonymously to public Twitch chat in read-only mode using the configured channel." },
      "fields": [
        { "key": "channel", "type": "string", "title": { "default": "Channel" } }
      ],
      "requiredCapabilities": ["live.ingest"]
    },
    {
      "id": "tiktools.twitch.disconnect",
      "version": 1,
      "title": { "default": "Disconnect Twitch" },
      "description": { "default": "Stop the Twitch connection." }
    },
    {
      "id": "tiktools.twitch.status",
      "version": 1,
      "title": { "default": "Twitch status" },
      "description": { "default": "Show the current plugin connection state." }
    }
  ],
  "cliCommands": [
    {
      "id": "connect",
      "actionType": "tiktools.twitch.connect",
      "description": "Connect anonymously to Twitch chat in read-only mode"
    },
    {
      "id": "disconnect",
      "actionType": "tiktools.twitch.disconnect",
      "description": "Disconnect from Twitch chat"
    },
    {
      "id": "status",
      "actionType": "tiktools.twitch.status",
      "description": "Show Twitch plugin status"
    }
  ],
  "ui": {
    "apiVersion": 1,
    "mode": "declarative",
    "pages": [
      {
        "id": "main",
        "title": { "default": "Twitch Live" },
        "icon": "video",
        "body": {
          "type": "stack",
          "children": [
            {
              "type": "card",
              "title": {
                "default": "Connection"
              },
              "children": [
                {
                  "type": "text",
                  "key": "channelHelp",
                  "text": {
                    "default": "Enter the Twitch channel login, save it, then connect. The input is stored in this plugin's settings."
                  }
                },
                {
                  "type": "form",
                  "key": "channelForm"
                },
                {
                  "type": "action-status",
                  "key": "runtimeStatus",
                  "title": {
                    "default": "Connection status"
                  },
                  "action": {
                    "type": "plugin-action",
                    "actionType": "tiktools.twitch.status"
                  },
                  "pollMs": 2000,
                  "stateKey": "connectionPhase"
                },
                {
                  "type": "button",
                  "key": "connect",
                  "title": {
                    "default": "Connect"
                  },
                  "variant": "primary",
                  "action": {
                    "type": "plugin-action",
                    "actionType": "tiktools.twitch.connect"
                  },
                  "disabledWhen": {
                    "bind": "local.connectionPhase",
                    "values": [
                      "connecting",
                      "connected",
                      "reconnecting"
                    ]
                  }
                },
                {
                  "type": "button",
                  "key": "disconnect",
                  "title": {
                    "default": "Disconnect"
                  },
                  "variant": "danger",
                  "action": {
                    "type": "plugin-action",
                    "actionType": "tiktools.twitch.disconnect"
                  },
                  "disabledWhen": {
                    "bind": "local.connectionPhase",
                    "values": [
                      "stopped",
                      "failed"
                    ]
                  }
                }
              ]
            },
            {
              "type": "card",
              "title": {
                "default": "Anonymous read-only IRC"
              },
              "children": [
                {
                  "type": "status",
                  "tone": "info",
                  "text": {
                    "default": "No OAuth token required. This reference uses Twitch's historical anonymous read-only IRC login."
                  }
                },
                {
                  "type": "text",
                  "text": {
                    "default": "Receives public chat, subscription notifications and Bits only. It cannot send messages, moderate, or receive follows, channel point redeems or private monetary data."
                  }
                }
              ]
            },
            {
              "type": "card",
              "title": {
                "default": "Production path"
              },
              "children": [
                {
                  "type": "text",
                  "text": {
                    "default": "Production providers should migrate to authenticated IRC with chat:read or EventSub. Feed, automation, points and analytics remain host-owned."
                  }
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
