{
  "templateVersion": 1,
  "id": "likes-every-15-global",
  "title": "Every 15 observed likes (global)",
  "description": "Runs once per crossed 15-like milestone, including multiple executions if one TikTok like batch crosses several multiples; existing one-shot templates stay unchanged.",
  "actions": [
    {
      "name": "Log recurring like milestone",
      "typeId": "core.log",
      "config": {
        "message": "A new 15-like milestone was crossed"
      }
    }
  ],
  "event": {
    "name": "Every 15 likes",
    "trigger": "tiktok.like",
    "cooldownMs": 0,
    "cooldownScope": "global",
    "filters": [
      {
        "path": "event.data.aggregation.global",
        "operator": "crosses-multiple",
        "value": "15"
      }
    ]
  }
}
