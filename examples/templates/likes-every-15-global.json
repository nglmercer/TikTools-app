{
  "templateVersion": 1,
  "id": "likes-every-15-global",
  "title": "Every 15 observed likes (global)",
  "description": "Runs once per incoming like batch that crosses a new multiple of 15; unlike the one-shot 15-like goal, this can fire again at 30, 45, 60, etc.",
  "actions": [
    {
      "name": "Log recurring like milestone",
      "typeId": "core.log",
      "config": {
        "message": "A new 15-like milestone was crossed"
      }
    }
  ],
  "event": {
    "name": "Every 15 likes",
    "trigger": "tiktok.like",
    "cooldownMs": 0,
    "cooldownScope": "global",
    "filters": [
      {
        "path": "event.data.aggregation.global",
        "operator": "crosses-multiple",
        "value": "15"
      }
    ]
  }
}
