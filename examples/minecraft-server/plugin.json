{
  "schemaVersion": 3,
  "id": "minecraft.server",
  "name": "Minecraft Server",
  "version": "1.0.0",
  "publisher": "tiktools",
  "license": "MIT",
  "engines": { "tiktools": ">=0.3.3, <0.4.0" },
  "categories": ["games", "integrations"],
  "repository": "https://github.com/nglmercer/TikTools-app",
  "description": "Drive a local Minecraft server through the CommandAPI mod over plain HTTP. No plugin code runs: the host interprets every action.",
  "longDescription": "Drive a local Minecraft server through the CommandAPI mod over plain HTTP. **No plugin code runs**: the host interprets every action.\n\n- Structured actions for items, mobs, effects, weather, and chat\n- The CommandAPI documents no health endpoint, so there is no connection probe: use Run test on an action (dry run) to preview the request\n- Start Minecraft with the mod and join a world first (commands fail while no world is loaded)",
  "icon": "terminal",
  "tags": ["minecraft", "game", "commands", "server"],
  "runtime": "declarative",
  "capabilities": ["http.request"],
  "permissions": [],
  "http": {
    "baseUrl": "{{ settings.serverUrl }}",
    "timeoutMs": 5000
  },
  "actionTypes": [
    {
      "id": "minecraft.server.give-item",
      "version": 1,
      "title": {"default": "Give Item"},
      "description": {"default": "Give an item to a player."},
      "tag": "minecraft",
      "icon": "gift",
      "category": "Items",
      "requiredCapabilities": ["http.request"],
      "fields": [
        {
          "key": "item",
          "label": {"default": "Item"},
          "kind": "select",
          "value": "minecraft:apple",
          "options": [
            {"value": "minecraft:apple", "label": {"default": "Apple"}},
            {"value": "minecraft:bread", "label": {"default": "Bread"}},
            {"value": "minecraft:golden_apple", "label": {"default": "Golden Apple"}},
            {"value": "minecraft:enchanted_golden_apple", "label": {"default": "Enchanted Golden Apple"}},
            {"value": "minecraft:diamond", "label": {"default": "Diamond"}},
            {"value": "minecraft:iron_ingot", "label": {"default": "Iron Ingot"}},
            {"value": "minecraft:gold_ingot", "label": {"default": "Gold Ingot"}},
            {"value": "minecraft:iron_sword", "label": {"default": "Iron Sword"}},
            {"value": "minecraft:diamond_sword", "label": {"default": "Diamond Sword"}},
            {"value": "minecraft:bow", "label": {"default": "Bow"}},
            {"value": "minecraft:arrow", "label": {"default": "Arrow"}},
            {"value": "minecraft:shield", "label": {"default": "Shield"}},
            {"value": "minecraft:torch", "label": {"default": "Torch"}},
            {"value": "minecraft:ender_pearl", "label": {"default": "Ender Pearl"}},
            {"value": "minecraft:tnt", "label": {"default": "TNT"}},
            {"value": "minecraft:elytra", "label": {"default": "Elytra"}},
            {"value": "minecraft:totem_of_undying", "label": {"default": "Totem of Undying"}},
            {"value": "minecraft:experience_bottle", "label": {"default": "Bottle o' Enchanting"}},
            {"value": "minecraft:firework_rocket", "label": {"default": "Firework Rocket"}},
            {"value": "minecraft:cooked_beef", "label": {"default": "Cooked Beef"}}
          ],
          "hint": {"default": "Curated item list. Anything else runs through the Run Command action."}
        },
        {
          "key": "amount",
          "label": {"default": "Amount"},
          "kind": "number",
          "value": "1",
          "min": 1,
          "max": 64
        },
        {
          "key": "target",
          "label": {"default": "Target Player"},
          "kind": "select",
          "value": "@p",
          "options": [
            {"value": "@p", "label": {"default": "Nearest player"}},
            {"value": "@a", "label": {"default": "All players"}},
            {"value": "@r", "label": {"default": "Random player"}}
          ]
        }
      ],
      "http": {
        "method": "POST",
        "path": "/api/chat",
        "headers": {"Content-Type": "application/json"},
        "body": "{\"text\": \"/give {{ config.target }} {{ config.item }} {{ config.amount }}\"}",
        "timeoutMs": 5000
      }
    },
    {
      "id": "minecraft.server.spawn-mob",
      "version": 1,
      "title": {"default": "Spawn Mob"},
      "description": {"default": "Spawn a Minecraft entity near a player."},
      "tag": "minecraft",
      "icon": "sparkles",
      "category": "Mobs",
      "requiredCapabilities": ["http.request"],
      "fields": [
        {
          "key": "entity",
          "label": {"default": "Entity"},
          "kind": "select",
          "value": "minecraft:zombie",
          "options": [
            {"value": "minecraft:zombie", "label": {"default": "Zombie"}},
            {"value": "minecraft:skeleton", "label": {"default": "Skeleton"}},
            {"value": "minecraft:creeper", "label": {"default": "Creeper"}},
            {"value": "minecraft:spider", "label": {"default": "Spider"}},
            {"value": "minecraft:enderman", "label": {"default": "Enderman"}},
            {"value": "minecraft:witch", "label": {"default": "Witch"}},
            {"value": "minecraft:slime", "label": {"default": "Slime"}},
            {"value": "minecraft:pig", "label": {"default": "Pig"}},
            {"value": "minecraft:cow", "label": {"default": "Cow"}},
            {"value": "minecraft:sheep", "label": {"default": "Sheep"}},
            {"value": "minecraft:chicken", "label": {"default": "Chicken"}},
            {"value": "minecraft:wolf", "label": {"default": "Wolf"}},
            {"value": "minecraft:villager", "label": {"default": "Villager"}},
            {"value": "minecraft:iron_golem", "label": {"default": "Iron Golem"}},
            {"value": "minecraft:blaze", "label": {"default": "Blaze"}},
            {"value": "minecraft:ghast", "label": {"default": "Ghast"}}
          ]
        },
        {
          "key": "target",
          "label": {"default": "Spawn Near"},
          "kind": "select",
          "value": "@p",
          "options": [
            {"value": "@p", "label": {"default": "Nearest player"}},
            {"value": "@a", "label": {"default": "All players"}},
            {"value": "@r", "label": {"default": "Random player"}}
          ],
          "hint": {"default": "The mob spawns at this player's position."}
        }
      ],
      "http": {
        "method": "POST",
        "path": "/api/chat",
        "headers": {"Content-Type": "application/json"},
        "body": "{\"text\": \"/execute at {{ config.target }} run summon {{ config.entity }} ~ ~ ~\"}",
        "timeoutMs": 5000
      }
    },
    {
      "id": "minecraft.server.apply-effect",
      "version": 1,
      "title": {"default": "Apply Effect"},
      "description": {"default": "Apply a potion effect to a player."},
      "tag": "minecraft",
      "icon": "bolt",
      "category": "Effects",
      "requiredCapabilities": ["http.request"],
      "fields": [
        {
          "key": "effect",
          "label": {"default": "Effect"},
          "kind": "select",
          "value": "minecraft:speed",
          "options": [
            {"value": "minecraft:speed", "label": {"default": "Speed"}},
            {"value": "minecraft:slowness", "label": {"default": "Slowness"}},
            {"value": "minecraft:strength", "label": {"default": "Strength"}},
            {"value": "minecraft:jump_boost", "label": {"default": "Jump Boost"}},
            {"value": "minecraft:regeneration", "label": {"default": "Regeneration"}},
            {"value": "minecraft:resistance", "label": {"default": "Resistance"}},
            {"value": "minecraft:fire_resistance", "label": {"default": "Fire Resistance"}},
            {"value": "minecraft:water_breathing", "label": {"default": "Water Breathing"}},
            {"value": "minecraft:invisibility", "label": {"default": "Invisibility"}},
            {"value": "minecraft:night_vision", "label": {"default": "Night Vision"}},
            {"value": "minecraft:health_boost", "label": {"default": "Health Boost"}},
            {"value": "minecraft:absorption", "label": {"default": "Absorption"}},
            {"value": "minecraft:glowing", "label": {"default": "Glowing"}},
            {"value": "minecraft:luck", "label": {"default": "Luck"}}
          ]
        },
        {
          "key": "duration",
          "label": {"default": "Duration (seconds)"},
          "kind": "number",
          "value": "30",
          "min": 1,
          "max": 1000000
        },
        {
          "key": "amplifier",
          "label": {"default": "Level"},
          "kind": "number",
          "value": "0",
          "min": 0,
          "max": 255,
          "hint": {"default": "0 is level I, 1 is level II, and so on."}
        },
        {
          "key": "target",
          "label": {"default": "Target Player"},
          "kind": "select",
          "value": "@p",
          "options": [
            {"value": "@p", "label": {"default": "Nearest player"}},
            {"value": "@a", "label": {"default": "All players"}},
            {"value": "@r", "label": {"default": "Random player"}}
          ]
        }
      ],
      "http": {
        "method": "POST",
        "path": "/api/chat",
        "headers": {"Content-Type": "application/json"},
        "body": "{\"text\": \"/effect give {{ config.target }} {{ config.effect }} {{ config.duration }} {{ config.amplifier }}\"}",
        "timeoutMs": 5000
      }
    },
    {
      "id": "minecraft.server.change-weather",
      "version": 1,
      "title": {"default": "Change Weather"},
      "description": {"default": "Change the Minecraft weather."},
      "tag": "minecraft",
      "icon": "cloud",
      "category": "World",
      "requiredCapabilities": ["http.request"],
      "fields": [
        {
          "key": "weather",
          "label": {"default": "Weather"},
          "kind": "select",
          "value": "clear",
          "options": [
            {"value": "clear", "label": {"default": "Clear"}},
            {"value": "rain", "label": {"default": "Rain"}},
            {"value": "thunder", "label": {"default": "Thunderstorm"}}
          ]
        },
        {
          "key": "duration",
          "label": {"default": "Duration (seconds)"},
          "kind": "number",
          "value": "300",
          "min": 1,
          "max": 1000000
        }
      ],
      "http": {
        "method": "POST",
        "path": "/api/chat",
        "headers": {"Content-Type": "application/json"},
        "body": "{\"text\": \"/weather {{ config.weather }} {{ config.duration }}\"}",
        "timeoutMs": 5000
      }
    },
    {
      "id": "minecraft.server.send-message",
      "version": 1,
      "title": {"default": "Send Message"},
      "description": {"default": "Send a chat message to the server."},
      "tag": "minecraft",
      "icon": "chat",
      "category": "Chat",
      "requiredCapabilities": ["http.request"],
      "fields": [
        {
          "key": "message",
          "label": {"default": "Message"},
          "kind": "textarea",
          "value": "Hello from TikTok!",
          "template": true,
          "placeholder": "Thanks {{ event.user.nickname }}!",
          "hint": {"default": "Sent as server chat (/say). Event placeholders render per event."}
        }
      ],
      "http": {
        "method": "POST",
        "path": "/api/chat",
        "headers": {"Content-Type": "application/json"},
        "body": "{\"text\": \"/say {{ config.message }}\"}",
        "timeoutMs": 5000
      }
    },
    {
      "id": "minecraft.server.run-command",
      "version": 1,
      "title": {"default": "Run Command"},
      "description": {"default": "Execute an advanced raw command. Runs exactly as typed."},
      "tag": "minecraft",
      "icon": "terminal",
      "category": "Advanced",
      "requiredCapabilities": ["http.request"],
      "fields": [
        {
          "key": "command",
          "label": {"default": "Command"},
          "kind": "text",
          "value": "/say Hello from TikTok!",
          "template": true,
          "placeholder": "/title @a title {\"text\":\"Hello!\"}",
          "hint": {"default": "Advanced: runs exactly as typed, with no validation. Prefer the structured actions above."}
        }
      ],
      "http": {
        "method": "POST",
        "path": "/api/chat",
        "headers": {"Content-Type": "application/json"},
        "body": "{\"text\": \"{{ config.command }}\"}",
        "timeoutMs": 5000
      }
    }
  ],
  "settings": {
    "schema": {
      "type": "object",
      "properties": {
        "serverUrl": {
          "type": "string",
          "format": "uri",
          "title": "Server URL",
          "description": "Base URL of the CommandAPI mod. The port changes on every Minecraft start: either pin it in-game (/commandapi port 8080) or update this setting after each start.",
          "default": "http://127.0.0.1:8080"
        }
      }
    },
    "uiHints": {
      "fields": {
        "serverUrl": {
          "placeholder": "http://127.0.0.1:8080"
        }
      }
    }
  }
}
