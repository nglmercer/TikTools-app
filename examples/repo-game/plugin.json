{
  "schemaVersion": 3,
  "id": "repo.game",
  "name": "R.E.P.O. Game",
  "version": "1.0.0",
  "publisher": "tiktools",
  "license": "MIT",
  "engines": { "tiktools": ">=0.3.3, <0.4.0" },
  "categories": ["games", "integrations"],
  "repository": "https://github.com/nglmercer/TikTools-app",
  "description": "Control R.E.P.O. gameplay through its local REST API.",
  "icon": "terminal",
  "tags": [
    "game",
    "repo",
    "tiktok",
    "interactive"
  ],
  "runtime": "declarative",
  "capabilities": [
    "http.request"
  ],
  "permissions": [],
  "http": {
    "baseUrl": "{{ settings.serverUrl }}",
    "timeoutMs": 10000,
    "auth": {
      "type": "bearer",
      "tokenSetting": "apiToken"
    },
    "health": {
      "path": "/health",
      "timeoutMs": 5000,
      "readinessField": "gameplayReady"
    },
    "tokenImport": {
      "format": "ini",
      "fileName": "org.repo.rest-api.cfg",
      "section": "HTTP",
      "key": "AuthenticationToken",
      "minLength": 43,
      "discovery": {
        "steamFolder": "REPO",
        "modManagerGame": "REPO",
        "relativePath": "BepInEx/config/org.repo.rest-api.cfg"
      },
      "connection": {
        "setting": "serverUrl",
        "section": "HTTP",
        "hostKey": "Host",
        "portKey": "Port"
      }
    }
  },
  "settings": {
    "schema": {
      "type": "object",
      "properties": {
        "serverUrl": {
          "type": "string",
          "format": "uri",
          "title": "Server URL",
          "default": "http://127.0.0.1:17453"
        },
        "apiToken": {
          "type": "string",
          "title": "API token",
          "secret": true,
          "description": "Use Connect automatically or select the game/profile folder. File import and manual token entry remain available."
        },
        "positionMode": {
          "type": "string",
          "title": "Default spawn position",
          "default": "random_player",
          "enum": [
            "near_player",
            "random_player",
            "random_valid",
            "world_position"
          ]
        },
        "quantity": {
          "type": "integer",
          "title": "Default quantity",
          "default": 1,
          "minimum": 1,
          "maximum": 10
        },
        "playerId": {
          "type": "string",
          "title": "Default player ID",
          "default": ""
        }
      }
    },
    "uiHints": {
      "fields": {
        "apiToken": {
          "secret": true
        },
        "playerId": {
          "optionsFrom": "plugin-action-options:repo.game.heal-player:playerId",
          "kind": "select"
        }
      }
    }
  },
  "pages": [
    {
      "id": "connection",
      "title": {
        "default": "R.E.P.O. connection"
      },
      "icon": "terminal",
      "sections": [
        {
          "kind": "text",
          "text": {
            "default": "Start R.E.P.O. with REPOapi once. Use Connect automatically and choose your Steam installation or active mod profile. If it is not found, select the game/profile folder. TikTools imports the token and API port without showing credentials. Gameplay requires an active level and host authority."
          }
        },
        {
          "kind": "connection"
        }
      ]
    }
  ],
  "actionTypes": [
    {
      "id": "repo.game.spawn-enemy",
      "version": 1,
      "title": {
        "default": "Spawn enemy"
      },
      "description": {
        "default": "Spawn enemy. Requires host gameplay readiness."
      },
      "tag": "repo",
      "icon": "terminal",
      "category": "R.E.P.O.",
      "requiredCapabilities": [
        "http.request"
      ],
      "fields": [
        {
          "key": "enemyId",
          "label": {
            "default": "Enemy"
          },
          "kind": "select",
          "value": "",
          "optionsFrom": "plugin-action-options:repo.game.spawn-enemy:enemyId"
        },
        {
          "key": "quantity",
          "label": {
            "default": "Quantity (blank uses setting)"
          },
          "kind": "number",
          "value": "",
          "min": 1,
          "max": 10
        },
        {
          "key": "positionMode",
          "label": {
            "default": "Position"
          },
          "kind": "select",
          "value": "",
          "options": [
            {
              "value": "",
              "label": {
                "default": "Use default"
              }
            },
            {
              "value": "near_player",
              "label": {
                "default": "Near player"
              }
            },
            {
              "value": "random_player",
              "label": {
                "default": "Random player"
              }
            },
            {
              "value": "random_valid",
              "label": {
                "default": "Random valid"
              }
            },
            {
              "value": "world_position",
              "label": {
                "default": "World position"
              }
            }
          ]
        },
        {
          "key": "playerId",
          "label": {
            "default": "Player (near player only)"
          },
          "kind": "select",
          "value": "",
          "optionsFrom": "plugin-action-options:repo.game.spawn-enemy:playerId"
        },
        {
          "key": "x",
          "label": {
            "default": "X (world position only)"
          },
          "kind": "number",
          "value": "0",
          "min": -10000,
          "max": 10000
        },
        {
          "key": "y",
          "label": {
            "default": "Y (world position only)"
          },
          "kind": "number",
          "value": "0",
          "min": -10000,
          "max": 10000
        },
        {
          "key": "z",
          "label": {
            "default": "Z (world position only)"
          },
          "kind": "number",
          "value": "0",
          "min": -10000,
          "max": 10000
        }
      ],
      "http": {
        "method": "POST",
        "path": "/api/spawn/enemy",
        "headers": {
          "Content-Type": "application/json"
        },
        "bodyJson": {
          "enemyId": {
            "$value": "config.enemyId"
          },
          "quantity": {
            "$number": "config.quantity",
            "fallback": "settings.quantity",
            "min": 1,
            "max": 10,
            "integer": true
          }
        },
        "idempotency": {
          "enabled": true,
          "header": "Idempotency-Key"
        },
        "timeoutMs": 10000,
        "bodyVariants": {
          "field": "positionMode",
          "values": {
            "near_player": {
              "position": {
                "mode": "near_player",
                "playerId": {
                  "$value": "config.playerId",
                  "fallback": "settings.playerId"
                }
              }
            },
            "random_player": {
              "position": {
                "mode": "random_player"
              }
            },
            "random_valid": {
              "position": {
                "mode": "random_valid"
              }
            },
            "world_position": {
              "position": {
                "mode": "world_position",
                "x": {
                  "$number": "config.x",
                  "min": -10000,
                  "max": 10000
                },
                "y": {
                  "$number": "config.y",
                  "min": -10000,
                  "max": 10000
                },
                "z": {
                  "$number": "config.z",
                  "min": -10000,
                  "max": 10000
                }
              }
            }
          }
        }
      },
      "optionSources": {
        "enemyId": {
          "path": "/api/catalog/enemies",
          "itemsPath": "enemies",
          "valuePath": "id",
          "labelPath": "name"
        },
        "playerId": {
          "path": "/api/players",
          "itemsPath": "players",
          "valuePath": "id",
          "labelPath": "name"
        }
      }
    },
