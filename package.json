{
  "name": "tiktok-live-appv3",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.1",
  "scripts": {
    "start": "bun run scripts/start-dev.ts",
    "start:packaged": "bun run scripts/start-packaged.ts",
    "prepare:dev-plugins": "bun run scripts/prepare-dev-plugins.ts",
    "start:rust": "cargo run -p tiktools-desktop",
    "dev": "bun run serve:web",
    "build:web": "vite build",
    "serve:web": "vite --host 127.0.0.1",
    "lint": "eslint src scripts vite.config.ts --max-warnings=0",
    "typecheck": "vue-tsc --noEmit",
    "test": "bun test src/web src/automation",
    "check:web": "bun run lint && bun run typecheck && bun run test && bun run build:web",
    "check:rust": "cargo check --workspace --locked",
    "lint:rust": "cargo clippy --workspace --all-targets --all-features --locked -- -D warnings",
    "fmt:rust": "cargo fmt --all -- --check",
    "test:rust": "cargo test --workspace --locked",
    "build:desktop": "cargo build -p tiktools-desktop --release --locked",
    "check:version": "bun run scripts/check-version.ts",
    "build:plugin": "bun run scripts/build-plugin.ts",
    "build:plugins": "bun run scripts/build-plugin.ts --all",
    "package:release": "bun run scripts/package-release.ts",
    "ci": "bun run check:web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "1.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "vue": "^3.5.42"
  }
}
