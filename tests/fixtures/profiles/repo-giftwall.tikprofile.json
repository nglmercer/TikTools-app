      "template": {
        "templateVersion": 1,
        "id": "repo-rule-0",
        "title": "Rose \u2192 item",
        "description": "Select catalog content in the action editor before enabling. Edit gift filter as needed.",
        "icon": "gift",
        "actions": [
          {
            "name": "Spawn item",
            "typeId": "repo.game.spawn-item",
            "enabled": true,
            "config": {
              "itemId": "",
              "quantity": 1,
              "positionMode": "random_player"
            }
          }
        ],
        "event": {
          "name": "Rose",
          "enabled": false,
          "trigger": "tiktok.gift",
          "filters": [
            {
              "path": "event.data.giftName",
              "operator": "eq",
              "value": "Rose"
            }
          ],
          "cooldownMs": 10000,
          "cooldownScope": "global",
          "runMode": "all"
        }
