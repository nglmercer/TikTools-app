{
  "profileVersion": 1,
  "id": "minecraft-giftwall",
  "name": "Minecraft gift wall",
  "description": "Gift wall on the Minecraft Server plugin: 14 gift rules (TNT tower, mobs, kills, teleports, jail, super chest) plus follow/share announcements. Every rule flashes a /title + subtitle naming the sender. Requires the minecraft.server plugin installed and enabled, with its Server URL pointing at the CommandAPI mod. Adjust gift names in the event editor to match your catalog.",
  "params": {},
  "templates": [
    {
      "template": {
        "templateVersion": 1,
        "id": "minecraft-tnt-tower",
        "title": "Rose = TNT Tower",
        "description": "Rose builds a TNT tower next to the nearest player, announced with a title + subtitle.",
        "icon": "gift",
        "actions": [
          {
            "name": "Announce: title timer",
            "typeId": "minecraft.server.run-command",
            "enabled": true,
            "config": {
              "command": "/title @a times 10 50 10"
            }
          },
          {
            "name": "Announce: subtitle thanks",
            "typeId": "minecraft.server.run-command",
            "enabled": true,
            "config": {
              "command": "/title @a subtitle {\"text\":\"¡Gracias, {{ event.user.nickname }}!\",\"color\":\"white\"}"
            }
          },
          {
            "name": "Announce: TNT tower title",
            "typeId": "minecraft.server.run-command",
            "enabled": true,
            "config": {
              "command": "/title @a title {\"text\":\"¡TNT TOWER!\",\"color\":\"red\",\"bold\":true}"
            }
          },
          {
            "name": "Build TNT tower",
            "typeId": "minecraft.server.run-command",
            "enabled": true,
            "config": {
              "command": "/execute at @p run fill ~2 ~ ~2 ~2 ~8 ~2 minecraft:tnt"
            }
          }
        ],
        "event": {
          "name": "Gift wall: Rose",
          "enabled": true,
          "trigger": "tiktok.gift",
          "filters": [{ "path": "event.data.giftName", "operator": "eq", "value": "Rose" }],
          "cooldownMs": 10000,
          "cooldownScope": "global",
          "runMode": "all"
        }
      },
      "params": {}
    },
