{
  "profileVersion": 1,
  "id": "peak-giftwall",
  "name": "PEAK giftwall",
  "description": "Listo para tu directo: cada regalo conocido invoca algo en PEAK. Requiere el plugin peak.game, PEAKapi en marcha y una partida con nivel activo en la que seas el anfitrión. Los IDs de item, entidad y peligro salen del catalogo de PEAKapi (/api/catalog/items, /api/catalog/entities, /api/catalog/hazards) y las entidades y peligros se mandan con tiempo de vida, asi que se limpian solos. Edita los filtros de regalo si en tu region tienen otro nombre.",
  "params": {},
  "templates": [
    {
      "template": {
        "templateVersion": 1,
        "id": "peak-gift-rose",
        "title": "Rosa → perrito caliente",
        "description": "Rosa (1 moneda) deja 1 perrito caliente a un jugador al azar.",
        "icon": "gift",
        "actions": [
          {
            "name": "Invocar perrito",
            "typeId": "peak.game.spawn-item",
            "enabled": true,
            "config": {
              "itemId": "Glizzy",
              "quantity": 1,
              "positionMode": "random_player"
            }
          }
        ],
        "event": {
          "name": "Rosa",
          "enabled": true,
          "trigger": "tiktok.gift",
          "filters": [
            {
              "path": "event.data.giftName",
              "operator": "eq",
              "value": "Rose"
            }
          ],
          "cooldownMs": 10000,
          "cooldownScope": "global",
          "runMode": "all"
        }
      },
      "params": {}
    },
