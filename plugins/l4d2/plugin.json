      "id": "l4d2.test_connection",
      "version": 1,
      "title": {
        "default": "Test connection"
      },
      "description": {
        "default": "Check the local L4D2api addon, heartbeat, host authority and active round. No gameplay side effects."
      },
      "tag": "l4d2",
      "icon": "connected",
      "category": "Connection",
      "requiredCapabilities": [],
      "timeoutMs": 15000,
      "fields": []
    },
