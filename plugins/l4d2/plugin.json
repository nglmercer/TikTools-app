  "settings": {
    "schema": {
      "type": "object",
      "properties": {
        "gameDir": {
          "type": "string",
          "title": "Game directory (optional)",
          "description": "Leave empty to discover Left 4 Dead 2 in Steam. Set only if auto-discovery fails.",
          "default": ""
        },
        "timeoutMs": {
          "type": "integer",
          "title": "IPC timeout (ms)",
          "description": "Time to wait for a reply from the game; timed-out actions are never retried automatically.",
          "minimum": 1000,
          "maximum": 12000,
          "default": 5000
        },
        "maxPerMinute": {
          "type": "integer",
          "title": "Max actions per minute",
          "description": "Upper limit for gameplay actions (the game enforces additional caps and cooldowns).",
          "minimum": 1,
          "maximum": 120,
          "default": 30
        }
      },
      "required": []
    },
    "uiHints": {
