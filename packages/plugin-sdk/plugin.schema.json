{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TikTools plugin manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "runtime"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "enum": [2, 3] },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "version": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S+$" },
    "description": { "type": "string", "maxLength": 4096 },
    "longDescription": { "type": "string", "maxLength": 16384 },
    "icon": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
    "tags": { "type": "array", "maxItems": 12, "items": { "type": "string", "pattern": "^[a-z0-9._-]{1,32}$" } },
    "runtime": { "enum": ["native", "process", "napi-vm", "declarative", "wasm"] },
    "entry": { "type": "string", "minLength": 1 },
    "apiVersion": { "type": "integer" },
    "trust": { "enum": ["trusted", "sandboxed", "untrusted"] },
    "capabilities": { "type": "array", "maxItems": 128, "items": { "type": "string", "pattern": "^\\S{1,256}$" } },
    "permissions": { "type": "array", "maxItems": 128, "items": { "type": "string", "pattern": "^\\S{1,256}$" } },
    "protocolVersion": { "const": 1 },
    "abiVersion": { "const": 1 },
    "targets": {
      "type": "array",
      "items": {
        "enum": ["win32-x64-msvc", "win32-arm64-msvc", "linux-x64-gnu", "linux-arm64-gnu", "darwin-x64-darwin", "darwin-arm64-darwin"]
      }
    },
    "actionTypes": { "type": "array", "maxItems": 128, "items": { "type": "object" } },
    "eventTypes": { "type": "array", "maxItems": 128, "items": { "type": "object" } },
    "eventSubscriptions": { "type": "array", "maxItems": 128, "items": { "type": "string" } },
    "processorTypes": { "type": "array", "maxItems": 128, "items": { "type": "object" } },
    "autocomplete": { "type": "array", "maxItems": 128, "items": { "type": "object" } },
    "settings": {
      "type": "object",
      "properties": {
        "schema": { "type": "object" },
        "uiHints": { "type": "object" }
      }
    },
    "http": { "type": "object" },
    "templates": { "type": "array", "items": { "type": "object" } },
    "pages": { "type": "array", "items": { "type": "object" } },
    "ui": {
      "type": "object",
      "required": ["apiVersion", "mode"],
      "properties": {
        "apiVersion": { "const": 1 },
        "mode": { "enum": ["declarative", "webview"] },
        "entry": { "type": "string", "pattern": "^ui/.+\\.html$" },
        "pages": { "type": "array", "items": { "type": "object" } }
      }
    },
    "nativeAddons": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["package", "root"],
        "properties": {
          "package": { "type": "string" },
          "root": { "type": "string" }
        }
      }
    },
    "nativeLibs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["package", "version"],
        "properties": {
          "package": { "type": "string" },
          "version": { "type": "string" },
          "provider": { "enum": ["npm", "github"] },
          "repo": { "type": "string" },
          "tag": { "type": "string" },
          "binary": { "type": "string" }
        }
      }
    },
    "publisher": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,37}[a-z0-9]$" },
    "authors": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "email": { "type": "string" },
              "url": { "type": "string", "pattern": "^https://" }
            }
          }
        ]
      }
    },
    "license": { "type": "string", "maxLength": 128 },
    "homepage": { "type": "string", "pattern": "^https://" },
    "repository": { "type": "string", "pattern": "^https://" },
    "engines": {
      "type": "object",
      "properties": {
        "tiktools": { "type": "string", "description": "Semver range of TikTools versions this plugin supports, for example >=0.4.0." }
      }
    },
    "dependencies": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": { "type": "string" }
    },
    "categories": {
      "type": "array",
      "maxItems": 4,
      "items": { "enum": ["audio", "chat", "games", "overlays", "moderation", "integrations", "utilities", "ai"] }
    },
    "changelog": { "type": "string", "pattern": "\\.md$" }
  }
}
