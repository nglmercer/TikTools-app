  "required": [
    "automationUser",
    "automationCreator",
    "automationPoints",
    "automationEvent",
    "automationIntel",
    "chat",
    "gift",
    "like",
    "social",
    "member",
    "roomStats",
    "connection",
    "pointsAwarded",
    "pluginEmit"
