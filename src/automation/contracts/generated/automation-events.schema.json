  "properties": {
    "automationUser": {
      "$ref": "#/$defs/AutomationUser"
    },
    "automationCreator": {
      "$ref": "#/$defs/AutomationCreator"
    },
    "automationPoints": {
      "$ref": "#/$defs/AutomationPoints"
    },
    "automationEvent": {
      "$ref": "#/$defs/AutomationEvent"
    },
    "automationIntel": {
      "$ref": "#/$defs/EventIntel"
    },
    "chat": {
      "$ref": "#/$defs/ChatAutomationData"
    },
    "gift": {
      "$ref": "#/$defs/GiftAutomationData"
    },
    "like": {
      "$ref": "#/$defs/LikeAutomationData"
    },
    "social": {
      "$ref": "#/$defs/SocialAutomationData"
    },
    "member": {
      "$ref": "#/$defs/MemberAutomationData"
    },
    "roomStats": {
      "$ref": "#/$defs/RoomStatsAutomationData"
    },
    "connection": {
      "$ref": "#/$defs/ConnectionAutomationData"
