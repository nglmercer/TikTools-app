          "type": "string"
        },
        "nickname": {
          "type": "string"
        },
        "secUid": {
          "type": "string"
        },
        "avatarUrl": {
          "description": "Display-only avatar URL from the live event. Optional so older\nproducers/consumers keep working; renderers must fall back to\ninitials when it is absent.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "uniqueId",
        "nickname",
        "secUid"
      ]
    },
